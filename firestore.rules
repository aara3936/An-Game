rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Entity Validation: SimulationRecord
    function isValidSimulationRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'score', 'intercepts', 'cityIntegrity', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'score', 'intercepts', 'cityIntegrity', 'enemyIntegrity', 'weatherCondition', 'victory', 'createdAt']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        data.score is number && data.score >= 0 &&
        data.intercepts is number && data.intercepts >= 0 &&
        data.cityIntegrity is number && data.cityIntegrity >= 0 && data.cityIntegrity <= 100 &&
        (!('enemyIntegrity' in data) || (data.enemyIntegrity is number && data.enemyIntegrity >= 0 && data.enemyIntegrity <= 100)) &&
        (!('weatherCondition' in data) || data.weatherCondition in ['ClearSkies', 'RainShower', 'HeavyThunderstorm']) &&
        (!('victory' in data) || data.victory is bool) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Entity Validation: TacticalConfig
    function isValidTacticalConfig(data) {
      return data.keys().hasAll(['userId', 'autoDefense', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'autoDefense', 'preferredWeather', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.autoDefense is bool &&
        (!('preferredWeather' in data) || data.preferredWeather in ['ClearSkies', 'RainShower', 'HeavyThunderstorm']) &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow query scraping of user profiles

      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == userId &&
        isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == existing().userId &&
        isValidUserProfile(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Collection: /simulation_records/{recordId}
    match /simulation_records/{recordId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(recordId) &&
        incoming().userId == request.auth.uid &&
        incoming().id == recordId &&
        isValidSimulationRecord(incoming());

      allow update: if false; // Battle records are immutable post-combat logs
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Collection: /tactical_configs/{userId}
    match /tactical_configs/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == userId &&
        isValidTacticalConfig(incoming());

      allow update: if isOwner(userId) && isValidId(userId) &&
        incoming().userId == existing().userId &&
        isValidTacticalConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['autoDefense', 'preferredWeather', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
